# ==================== SERVER ====================
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Vergul bilan ajratilgan ruxsat etilgan originlar (CORS)
CORS_ORIGINS=https://admin.example.com,https://scanner.example.com

# ==================== DATABASE ====================
DATABASE_URL="postgresql://qr_badge_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/qr_badge_db?schema=public"

# ==================== REDIS ====================
REDIS_URL="redis://localhost:6379"

# ==================== JWT (Admin panel / staff auth) ====================
# openssl rand -base64 64 orqali generatsiya qiling. Har biri BOSHQA-BOSHQA maxfiy kalit bo'lishi SHART.
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_64_BYTE_SECRET_ACCESS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_64_BYTE_SECRET_REFRESH
JWT_REFRESH_EXPIRES_IN=7d

# ==================== QR / BADGE TOKEN ====================
# Ishtirokchi QR kodlari ichidagi token shu kalit bilan imzolanadi (JWT_ACCESS_SECRET dan FARQLI bo'lishi shart)
QR_TOKEN_SECRET=CHANGE_ME_RANDOM_64_BYTE_SECRET_QR
# QR tokenning "logical" amal qilish muddati (badge holati baribir serverda tekshiriladi)
QR_TOKEN_EXPIRES_IN=730d

# ==================== SCANNER DEVICE AUTH ====================
DEVICE_TOKEN_SECRET=CHANGE_ME_RANDOM_64_BYTE_SECRET_DEVICE
DEVICE_TOKEN_EXPIRES_IN=12h

# ==================== OFFLINE SYNC PACKAGE ====================
OFFLINE_PACKAGE_SECRET=CHANGE_ME_RANDOM_64_BYTE_SECRET_OFFLINE

# ==================== PII ENCRYPTION ====================
# PINFL kabi shaxsiy ma'lumotlarni bazada shifrlash uchun (AES-256-GCM)
PINFL_ENCRYPTION_SECRET=CHANGE_ME_RANDOM_64_BYTE_SECRET_PINFL

# ==================== PASSWORD / SECURITY POLICY ====================
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ==================== RATE LIMIT ====================
THROTTLE_TTL=60
THROTTLE_LIMIT=120
SCAN_THROTTLE_TTL=1
SCAN_THROTTLE_LIMIT=5

# ==================== FILE STORAGE ====================
UPLOAD_DIR=./uploads
BADGE_OUTPUT_DIR=./storage/badges
